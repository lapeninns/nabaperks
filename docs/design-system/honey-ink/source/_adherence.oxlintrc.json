{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/loyalty/**",
              "components/surfaces/**",
              "v2/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='CelebrationBits'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|mo|seed|key|ref|className|style|children)$/]",
        "message": "<CelebrationBits> doesn't accept that prop. Declared props: type, mo, seed."
      },
      {
        "selector": "JSXOpeningElement[name.name='CelebrationBits'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:Slam|Ripple|Burst)$/]",
        "message": "<CelebrationBits> type must be one of 'Slam' | 'Ripple' | 'Burst'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GhostLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<GhostLink> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='InkButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|disabled|children|key|ref|className|style|children)$/]",
        "message": "<InkButton> doesn't accept that prop. Declared props: variant, size, full, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='InkButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline)$/]",
        "message": "<InkButton> variant must be one of 'primary' | 'dark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InkButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<InkButton> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<MonoTag> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|accent|ink)$/]",
        "message": "<MonoTag> tone must be one of 'plain' | 'accent' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OtpBoxes'] > JSXAttribute > JSXIdentifier[name!=/^(?:length|value|onChange|key|ref|className|style|children)$/]",
        "message": "<OtpBoxes> doesn't accept that prop. Declared props: length, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinPad'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDone|label|sublabel|note|key|ref|className|style|children)$/]",
        "message": "<PinPad> doesn't accept that prop. Declared props: onDone, label, sublabel, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|label|key|ref|className|style|children)$/]",
        "message": "<ProgressLine> doesn't accept that prop. Declared props: current, total, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReceiptCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|shaking|mo|key|ref|className|style|children)$/]",
        "message": "<ReceiptCard> doesn't accept that prop. Declared props: children, style, shaking, mo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seal'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|onBroken|mo|size|key|ref|className|style|children)$/]",
        "message": "<Seal> doesn't accept that prop. Declared props: mode, onBroken, mo, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seal'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:Hold|Tap)$/]",
        "message": "<Seal> mode must be one of 'Hold' | 'Tap'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|children|mo|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, onClose, children, mo."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampDisc'] > JSXAttribute > JSXIdentifier[name!=/^(?:filled|index|slammed|celebration|mo|size|date|key|ref|className|style|children)$/]",
        "message": "<StampDisc> doesn't accept that prop. Declared props: filled, index, slammed, celebration, mo, size, date."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampDisc'] > JSXAttribute[name.name='celebration'] > Literal[value!=/^(?:Slam|Ripple|Burst)$/]",
        "message": "<StampDisc> celebration must be one of 'Slam' | 'Ripple' | 'Burst'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VenueMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|caption|size|color|angle|key|ref|className|style|children)$/]",
        "message": "<VenueMark> doesn't accept that prop. Declared props: initials, caption, size, color, angle."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
