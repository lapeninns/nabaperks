# Reviewed build arguments for ops/local-ci/image/Dockerfile.
#
# The Dockerfile gives these no default on purpose: an unverified download
# must fail the build. ops/local-ci/host/install.sh reads this file - it is
# parsed as KEY=VALUE data, never sourced - and passes each value as a
# --build-arg when it builds nabaperks-ci-job:<sha> on the desktop-linux
# context. Refresh a pin with the command in the pin ledger of
# ops/local-ci/host/README.md and change it here in the same commit.
K6_VERSION=2.2.0
K6_SHA256=4ecd64cadcc792402d16293836115480419c4447c032858f564852d98f1bf54c
SUPABASE_CLI_SHA256=a004217bc9e146e6aede8f7f26138fbd94cfdffa5ed4c6b9983bc8b804e5c928
