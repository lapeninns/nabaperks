{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "lib/customer/experience/block-reasons.ts",
    "lib/customer/phone-pii-core.ts",
    "lib/customer/qr-scanner.ts",
    "lib/customer/session-cookie-core.ts",
    "lib/customer/uk-calendar.ts",
    "lib/customer/uk-date.ts",
    "lib/merchant/reward-scanner.ts",
    "lib/security/rate-limit-core.ts"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --import ./tests/support/register-alias.mjs --test tests/unit/*.test.mjs"
  },
  "coverageAnalysis": "off",
  "reporters": ["progress", "clear-text", "html"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  }
}
