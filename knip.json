{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/**/*.mjs", "tests/**/*.{ts,tsx}"],
  "project": ["**/*.{ts,tsx}", "scripts/**/*.mjs"],
  "ignore": [
    "components/ui/**",
    "public/**",
    ".next/**",
    ".tmp/**",
    ".claude/**",
    "docs/**",
    "supabase/migrations/**"
  ],
  "ignoreBinaries": ["rg", "zsh"],
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error"
  }
}
