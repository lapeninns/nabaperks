    "security:verify": "node scripts/verify-security.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:flaky": "node scripts/test-flaky.mjs",
    "lint": "eslint",
    "lint:quality": "eslint --config eslint.quality.config.mjs --max-warnings 31 app lib components",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "deadcode": "knip",
    "duplication": "jscpd",
    "deps:analyze": "node scripts/analyze-deps.mjs",
    "bundle:size": "node scripts/check-bundle-size.mjs",
    "scan:todos": "node scripts/scan-todos.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check:nplus1": "node scripts/check-nplus1.mjs",
    "check:agents": "node scripts/check-agents-md.mjs",
    "docs:routes": "node scripts/generate-route-contract.mjs",
    "docs:routes:check": "node scripts/generate-route-contract.mjs --check",
    "quality": "pnpm check:naming && pnpm scan:todos && pnpm check:nplus1 && pnpm check:agents && pnpm lint:quality && pnpm docs:routes:check && pnpm deadcode && pnpm duplication",
    "goal:gate": "node scripts/run-goal-gate.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "input-otp": "^1.4.2",
    "libphonenumber-js": "^1.13.6",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.10.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.51.1",
