{
  "name": "nabaperks",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:micro-specs && pnpm test:unit",
    "test:micro-specs": "node --test tests/micro-specs/*.test.mjs",
    "test:unit": "node --import ./tests/support/register-alias.mjs --test tests/unit/*.test.mjs",
    "test:coverage": "mkdir -p coverage && node --import ./tests/support/register-alias.mjs --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70 --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test tests/unit/*.test.mjs",
    "test:db": "node --test tests/db/*.test.mjs",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:ui": "node scripts/run-playwright.mjs --ui",
    "test:e2e:headed": "node scripts/run-playwright.mjs --headed",
    "test:visual": "node scripts/run-playwright.mjs --grep @visual",
    "test:a11y": "node scripts/run-playwright.mjs --grep @a11y",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "lighthouse": "lhci autorun",
    "mutation:check": "stryker run",
    "qa:e2e": "CUSTOMER_DEV_OTP_CODE=424242 node scripts/run-playwright.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "governance:check": "node scripts/check-governance.mjs",
    "governance:run-gates": "node scripts/run-governance-gates.mjs",
    "governance:sync-skill": "node scripts/sync-skill-bundles.mjs",
    "db:migrate": "node scripts/run-supabase-sql.mjs --apply",
    "db:reset": "node scripts/run-supabase-sql.mjs --reset",
    "db:clean:customers": "node scripts/run-supabase-sql.mjs --reset-customers",
    "db:reset:today-stamps": "node scripts/run-supabase-sql.mjs --reset-today-stamps",
    "db:seed": "node scripts/run-supabase-sql.mjs --seed",
    "db:setup": "node scripts/run-supabase-sql.mjs --apply --seed",
    "env:check": "node scripts/check-env.mjs",
    "env:check:production": "node scripts/check-env.mjs --profile=production",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "claims:check": "node scripts/check-banned-claims.mjs",
    "jsonld:check": "node scripts/check-jsonld.mjs",
    "smoke:providers": "node scripts/check-provider-readiness.mjs",
    "smoke:supabase:migrations": "node scripts/check-supabase-migrations.mjs",
    "env:keys": "node scripts/env-keys.mjs status",
    "env:pull-supabase": "node scripts/env-keys.mjs pull-supabase",
    "env:set-posthog": "node scripts/env-keys.mjs set-posthog",
    "env:set-resend": "node scripts/env-keys.mjs set-resend",
    "env:push-vercel": "node scripts/env-keys.mjs push-vercel",
    "env:write-local": "node scripts/env-keys.mjs write-local"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.6",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "fast-check": "^4.8.0",
    "postgres": "^3.4.9",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8.61.0"
  }
}
