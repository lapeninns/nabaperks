    "db:test:rls": "node scripts/run-supabase-sql.mjs --test",
    "db:verify": "node scripts/verify-supabase-schema.mjs",
    "env:check": "node scripts/check-env.mjs",
    "env:keys": "node scripts/env-keys.mjs status",
    "env:pull-supabase": "node scripts/env-keys.mjs pull-supabase",
    "env:set-posthog": "node scripts/env-keys.mjs set-posthog",
    "env:set-resend": "node scripts/env-keys.mjs set-resend",
