{
  "name": "nabaperks",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "perf:routes": "node scripts/perf-routes.mjs",
    "db:migrate": "node scripts/run-supabase-sql.mjs --apply",
    "db:reset": "node scripts/run-supabase-sql.mjs --reset",
