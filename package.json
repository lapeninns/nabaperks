    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.7",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
