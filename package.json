{
  "name": "nabaperks",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "clean": "rm -rf .next .next-e2e coverage test-results playwright-report reports/lighthouse reports/mutation",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:contracts && pnpm test:unit",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:unit": "node --import ./tests/support/register-alias.mjs --test tests/unit/*.test.mjs",
    "test:coverage": "mkdir -p coverage && node --import ./tests/support/register-alias.mjs --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test tests/unit/*.test.mjs",
    "test:db": "node --test --test-concurrency=1 tests/db/*.test.mjs",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:ui": "node scripts/run-playwright.mjs --ui",
    "test:e2e:headed": "node scripts/run-playwright.mjs --headed",
    "test:visual": "node scripts/run-playwright.mjs --grep @visual",
    "posters:verify-pdfs": "node --import ./tests/support/register-alias.mjs scripts/verify-poster-pdfs.mjs",
    "posters:export-production": "node --import ./tests/support/register-alias.mjs scripts/export-production-poster-pdfs.mjs",
    "test:a11y": "node scripts/run-playwright.mjs --grep @a11y",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "lighthouse": "lhci autorun",
    "mutation:check": "stryker run",
    "security:audit": "pnpm audit",
    "qa:e2e": "CUSTOMER_DEV_OTP_CODE=424242 node scripts/run-playwright.mjs",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "deadcode:check": "knip --include files,dependencies,unresolved",
    "duplicates:check": "jscpd app components lib --config jscpd.json",
    "debt:check": "node scripts/check-technical-debt.mjs",
    "flags:check": "node scripts/check-feature-flags.mjs",
    "docs:generate": "node scripts/generate-api-docs.mjs && prettier --write docs/api/README.md",
    "docs:check": "pnpm docs:generate && git diff --exit-code -- docs/api/README.md",
    "agents:check": "node scripts/check-agent-docs.mjs",
    "quality:fast": "pnpm lint && pnpm typecheck && pnpm test",
    "quality:check": "pnpm quality:fast && pnpm deadcode:check && pnpm duplicates:check && pnpm debt:check && pnpm flags:check && pnpm docs:check && pnpm agents:check",
    "profile:server": "mkdir -p reports/profiles && node --cpu-prof --cpu-prof-dir=reports/profiles node_modules/next/dist/bin/next start",
    "db:migrate": "node scripts/run-supabase-sql.mjs --apply",
    "db:reset": "node scripts/run-supabase-sql.mjs --reset",
    "db:clean:customers": "node scripts/run-supabase-sql.mjs --reset-customers",
    "db:reset:today-stamps": "node scripts/run-supabase-sql.mjs --reset-today-stamps",
    "db:seed": "node scripts/run-supabase-sql.mjs --seed",
    "db:seed:stress": "node scripts/seed-stress.mjs",
    "db:clean:stress": "node scripts/seed-stress.mjs --clean",
    "db:reseed:stress": "node scripts/seed-stress.mjs --clean --count 10000",
    "perf:stress": "node scripts/perf-stress.mjs",
    "db:supabase:start": "node scripts/supabase-local.mjs start",
    "db:supabase:stop": "node scripts/supabase-local.mjs stop",
    "db:supabase:status": "node scripts/supabase-local.mjs status",
    "db:setup": "node scripts/run-supabase-sql.mjs --apply --seed",
    "db:migrate:list:linked": "node scripts/supabase-linked.mjs migration list --linked",
    "db:push:linked": "node scripts/supabase-linked.mjs db push --linked",
    "env:check": "node scripts/check-env.mjs",
    "env:check:production": "node scripts/check-env.mjs --profile=production",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "claims:check": "node scripts/check-banned-claims.mjs",
    "jsonld:check": "node scripts/check-jsonld.mjs",
    "seo:content-audit": "node scripts/audit-seo-content.mjs",
    "seo:crawl-audit": "node scripts/analyze-crawl-logs.mjs",
    "smoke:providers": "node scripts/check-provider-readiness.mjs",
    "smoke:staging": "node scripts/check-staging-release.mjs",
    "smoke:supabase:migrations": "node scripts/check-supabase-migrations.mjs",
    "ops:page": "node scripts/notify-production-alert.mjs",
    "ops:restore:verify": "node scripts/check-restored-backup.mjs",
    "ops:sentry:check": "node scripts/check-sentry-release.mjs verify",
    "ops:slo:check": "node scripts/check-production-slo.mjs",
    "ops:github:check": "node scripts/check-github-governance.mjs",
    "ops:supabase:check": "node scripts/check-supabase-governance.mjs",
    "ops:vercel:check": "node scripts/check-vercel-governance.mjs",
    "env:keys": "node scripts/env-keys.mjs status",
    "env:pull-supabase": "node scripts/env-keys.mjs pull-supabase",
    "env:set-posthog": "node scripts/env-keys.mjs set-posthog",
    "env:set-resend": "node scripts/env-keys.mjs set-resend",
    "env:push-vercel": "node scripts/env-keys.mjs push-vercel",
    "env:write-local": "node scripts/env-keys.mjs write-local"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^2.0.10",
      "brace-expansion@1.1.15": "1.1.16",
      "brace-expansion@5.0.6": "5.0.7",
      "body-parser@1.20.5": "1.20.6",
      "fast-uri": "^3.1.4",
      "hono@4.12.25": "4.12.27",
      "@vercel/fun>@tootallnate/once": "2.0.1",
      "@vercel/fun>path-to-regexp": "8.4.0",
      "@vercel/fun>tar": "7.5.19",
      "@vercel/python-analysis>js-yaml": "4.3.0",
      "@vercel/python-analysis>minimatch": "10.2.3",
      "@vercel/python-analysis>smol-toml": "1.6.1",
      "js-yaml@4.2.0": "4.3.0",
      "postcss": "8.5.15",
      "qs": "6.15.2",
      "sharp": "^0.35.0",
      "tmp": "0.2.7",
      "vercel>smol-toml": "1.6.1",
      "vercel>undici": "6.27.0",
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@pdf-lib/fontkit": "1.1.1",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.6",
    "motion": "^12.40.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "jsqr": "^1.4.0",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vercel": "56.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{mjs,json,md,yaml,yml}": "prettier --write"
  }
}
