{
  "name": "nabaperks",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:micro-specs": "node --test tests/micro-specs/*.test.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:migrate": "node scripts/run-supabase-sql.mjs --apply",
    "db:reset": "node scripts/run-supabase-sql.mjs --reset",
