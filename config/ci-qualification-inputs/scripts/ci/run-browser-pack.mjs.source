import { mkdirSync, writeFileSync } from "node:fs"
import { resolve, join } from "node:path"
import { pathToFileURL } from "node:url"
import { runBrowserPack, comparePackInventory } from "./browser-pack.mjs"

// A pack is nothing more than a grouping of whole /32 shards: the denominator
// stays at thirty-two, so Playwright's distribution of specs across shards is
// byte-identical to the original thirty-two-job matrix and the executed test
// set cannot move. Only which GitHub job carries each shard changes.
//
// Four packs of eight keep the e2e job count at sixteen (see ci.yml), so each
// job pays its ~78s of container, checkout, setup and inventory listing once
// for eight shards. Eight is safe for memory because a pack is sequential,
// never shared: each shard inside it still gets its own fresh Playwright
// server and verified wrapper cleanup (see runBrowserPack), which is exactly
// what keeps a job away from the out-of-memory kill an unsharded run hits
// after roughly 154 tests. Grouping must never be allowed to mean sharing one
// server.
//
// Packs used to be consecutive blocks (1-8, 9-16, ...). The heavy shards do
// not sit in one block, and where they sit differs by project: mobile-safari
// shards 17-32 carry most of its time, so its packs 3 and 4 were the slowest
// jobs of every run and the whole workflow's critical path. Per-shard slot
// times (fresh-server start to the next shard's start) were read from the
// job logs of ten successful ci.yml runs on 2026-09-28 (main 36441935237,
// 36437420996, 36427336904, 36423541908, 36415049980; pull requests
// 36439938612, 36435415664, 36435411326, 36433846948, 36431332627). Each
// project's shards were then assigned by longest-processing-time-first on
// their 85th-percentile slot time, eight to a pack, the bucketing
// gotestsum's `tool ci-matrix` uses for Go packages. Replayed against the
// same logs, the slowest pack per run falls from a median of 430s (max 458s)
// to 376s (max 388s); fitted on the pull-request runs alone and replayed on
// the main runs it falls from 427s to 369s. When the suite changes, shard
// boundaries move and this plan drifts towards an arbitrary grouping, which
// replays at about the old consecutive figure (random groupings: median
// 419s), so a stale plan costs balance, never coverage. Refresh it from new
// job logs the same way when the slowest pack drifts.
export const PACK_COUNT = 4
export const PACK_SHARD_COUNT = 8
export const BROWSER_SHARD_TOTAL = 32

export const PACK_PLAN = Object.freeze({
  chromium: [
    [1, 7, 9, 11, 14, 21, 22, 28],
    [2, 5, 6, 15, 25, 26, 29, 31],
    [3, 4, 12, 18, 19, 23, 24, 30],
    [8, 10, 13, 16, 17, 20, 27, 32],
  ],
  "mobile-safari": [
    [1, 6, 10, 12, 14, 21, 26, 27],
    [2, 3, 7, 11, 18, 24, 25, 28],
    [4, 8, 9, 16, 19, 23, 30, 32],
    [5, 13, 15, 17, 20, 22, 29, 31],
  ],
  "desktop-firefox": [
    [1, 5, 6, 7, 8, 11, 14, 29],
    [2, 4, 19, 21, 23, 28, 30, 31],
    [3, 9, 16, 20, 22, 25, 26, 32],
    [10, 12, 13, 15, 17, 18, 24, 27],
  ],
  "desktop-safari": [
    [1, 3, 11, 14, 21, 25, 28, 30],
    [2, 4, 6, 7, 16, 19, 22, 29],
    [5, 8, 9, 12, 13, 15, 23, 24],
    [10, 17, 18, 20, 26, 27, 31, 32],
  ],
})

// Every project's packs must tile 1/32..32/32 exactly once - no gaps and no
// duplicates - with eight shards in each of four packs. A hand-edited plan
// that drops or repeats a shard would silently stop running part of the
// suite, so assert that at load rather than trusting the table.
if (PACK_COUNT * PACK_SHARD_COUNT !== BROWSER_SHARD_TOTAL)
  throw new Error("Packs must cover every original shard exactly once")
for (const [project, packs] of Object.entries(PACK_PLAN)) {
  const shards = packs.flat()
  if (
    packs.length !== PACK_COUNT ||
    packs.some(
      (pack) =>
        pack.length !== PACK_SHARD_COUNT ||
        pack.some((shard, index) => index > 0 && pack[index - 1] >= shard)
    ) ||
    shards.length !== BROWSER_SHARD_TOTAL ||
    new Set(shards).size !== BROWSER_SHARD_TOTAL ||
    shards.some(
      (shard) =>
        !Number.isInteger(shard) || shard < 1 || shard > BROWSER_SHARD_TOTAL
    )
  )
    throw new Error(
      `Packs for ${project} must cover every original shard exactly once`
    )
}

export function packShards(project, pack) {
  if (!Object.hasOwn(PACK_PLAN, project))
    throw new Error("Project has no hosted e2e pack plan")
  if (!/^[1-4]$/.test(String(pack)))
    throw new Error("Pack must be an integer from 1 to 4")
  return PACK_PLAN[project][Number(pack) - 1].map(
    (shard) => `${shard}/${BROWSER_SHARD_TOTAL}`
  )
}

if (
  process.argv[1] &&
  import.meta.url === pathToFileURL(process.argv[1]).href
) {
  try {
    const [project, pack, output, ...extra] = process.argv.slice(2)
    if (!output || extra.length)
      throw new Error(
        "Usage: run-browser-pack.mjs <project> <1-4> <new-output-directory>"
      )
    const shards = packShards(project, pack)
    const root = resolve(output)
    mkdirSync(root)
    const listed = await runBrowserPack({
      project,
      shards,
      output: join(root, "listed"),
      listOnly: true,
    })
    const runtime = await runBrowserPack({
      project,
      shards,
      output: join(root, "runtime"),
    })
    const inventory = comparePackInventory(listed, runtime)
    if (!inventory.equivalent)
      throw new Error(
        "Executed test inventory differs from the original shard selection"
      )
    writeFileSync(
      join(root, "summary.json"),
      JSON.stringify(
        {
          project,
          pack: Number(pack),
          shards,
          inventory,
          tests: runtime.results.reduce(
            (total, result) => total + result.tests.length,
            0
          ),
          durationMs: runtime.results.reduce(
            (total, result) => total + result.durationMs,
            0
          ),
        },
        null,
        2
      ) + "\n"
    )
  } catch (error) {
    console.error(error.message)
    process.exitCode = 1
  }
}
