{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=3130 pnpm start",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 120000,
      "numberOfRuns": 2,
      "url": [
        "http://127.0.0.1:3130/",
        "http://127.0.0.1:3130/pricing",
        "http://127.0.0.1:3130/loyalty-for-pubs",
        "http://127.0.0.1:3130/signup"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "formFactor": "mobile"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^https?://[^/]+/(?:|pricing/?|loyalty-for-pubs/?)$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:performance": ["error", { "minScore": 0.7 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "first-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
            "total-blocking-time": ["error", { "maxNumericValue": 300 }]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/signup/?$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:performance": ["error", { "minScore": 0.7 }],
            "first-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
            "total-blocking-time": ["error", { "maxNumericValue": 300 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "reports/lighthouse"
    }
  }
}
