# Nabaperks environment example.
# Copy this file to .env.local for local development and replace the values.

# Public client-safe values. These may be bundled into browser JavaScript.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Optional Google Maps Platform browser key for Maps JavaScript + Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only secrets. Never expose these with NEXT_PUBLIC_ prefixes.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Optional direct Postgres URL for migration and SQL RLS verification.
SUPABASE_DB_URL=
# Optional fallback used with supabase/.temp/pooler-url when the project is linked locally.
SUPABASE_DB_PASSWORD=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_GROWTH_PRICE_ID=price_replace_me
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
RESEND_API_KEY=re_replace_me

# Optional server-side pseudonymous PostHog processing. It remains disabled
# unless the mode is exactly "pseudonymous" and all three settings are valid.
ANALYTICS_EXTERNAL_PROCESSING_MODE=disabled
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_PSEUDONYM_SECRET=

# Optional browser Web Push. Generate a VAPID key pair and keep the private key server-only.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
CRON_SECRET=
PRODUCTION_MONITOR_SECRET=

# Merchant/admin email auth. Route the Supabase Send Email hook through Resend.
RESEND_FROM="Nabaperks <login@nabaperks.com>"
SUPABASE_SEND_EMAIL_HOOK_SECRET=

# Customer phone auth. Customer OTPs use Twilio Verify directly, not Supabase SMS.
TWILIO_ACCOUNT_SID=
# Either set TWILIO_AUTH_TOKEN, or set TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET.
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# Local-only bypass. Set to any-4-digits to skip Twilio Verify and accept exactly 4 digits.
# Production-profile and Vercel preview/production checks reject any configured value.
CUSTOMER_OTP_BYPASS_MODE=
CUSTOMER_SESSION_SECRET=
CUSTOMER_PHONE_HMAC_SECRET=
CUSTOMER_PHONE_ENCRYPTION_KEY=
# Local development bypass. Hosted preview and production checks reject it.
CUSTOMER_DEV_OTP_CODE=

# Legacy Supabase Send SMS hook variables. Not used for customer OTP.
TWILIO_MESSAGING_SERVICE_SID=
SUPABASE_SEND_SMS_HOOK_SECRET=
